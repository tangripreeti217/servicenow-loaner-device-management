        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Set initial Status on insert
    if (current.status.nil()) {
        current.setValue('status', 'submitted');
    }

    // populate Email and Department on insert if blank
    if (current.employee) {
        var userGr = current.employee.getRefRecord();
        if (userGr.isValidRecord()) {
            if (current.employee_email.nil()) {
                current.setValue('employee_email', userGr.getValue('email'));
            }
            if (current.department.nil()) {
                current.setValue('department', userGr.getValue('department'));
            }
        }
    }

})(current, previous);
]]></script>
